# 目標系統
BASE_URL=https://attendance.example.com/

# 帳密（開發用 .env；正式請用 GitHub Secrets）
COMPANY_CODE=your_company_code
AOA_USERNAME=your_username
AOA_PASSWORD=your_password

# 地理資訊（若站點使用 HTML5 Geolocation）
AOA_LAT=0
AOA_LON=0

# 時區/語系
TZ=Asia/Taipei
LOCALE=zh-TW

# DISCORD_WEBHOOK_URL=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=

# 日誌等級 (可選): DEBUG, INFO, WARN, ERROR
# LOG_LEVEL=INFO

# Docker Compose 使用者映射（多數 WSL 發行版預設為 1000）
LOCAL_UID=1000
LOCAL_GID=1000
